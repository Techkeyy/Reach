# Browser-safe Tempo Moderato testnet reads. Never put signing keys in VITE_* variables.
VITE_TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
VITE_REACH_VAULT_ADDRESS=0x98262c02746f3b91342249159deeebe87a54266c

# Local WebAuthn origin must match the URL opened in the browser.
REACH_ORIGIN=http://localhost:5173
REACH_RP_ID=localhost
REACH_RPC_URL=https://rpc.moderato.tempo.xyz
REACH_VAULT_ADDRESS=0x98262c02746f3b91342249159deeebe87a54266c

# Durable server-side storage is required for deployed identities and sessions.
# Local development can use the in-memory adapter, which does not survive restart.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Server-only optional testnet sponsorship and Protected Payment delivery.
REACH_FEE_PAYER_PRIVATE_KEY=
REACH_PROTECTED_CLAIMS_ENCRYPTION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
REACH_PROTECTED_EMAIL_FROM=
