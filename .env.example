NEXT_PUBLIC_TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
NEXT_PUBLIC_TEMPO_CHAIN_ID=42431
NEXT_PUBLIC_TEMPO_EXPLORER_URL=https://explore.testnet.tempo.xyz
NEXT_PUBLIC_PAYOUT_VAULT_ADDRESS=0x98262c02746f3b91342249159deeebe87a54266c
DATABASE_URL=
CLAIM_SECRET_ENCRYPTION_KEY=
FEE_PAYER_URL=
MPP_SECRET_KEY=
# 32 random bytes as hex; server-only AES-GCM key for delegated agent signers.
REACH_AGENT_ENCRYPTION_KEY=
# Separate service recipient for MPP charges; do not point this at the payout vault.
REACH_MPP_RECIPIENT_ADDRESS=
REACH_MPP_PRICE=0.01
MPP_REALM=Reach agent service
# HMAC secret for binding a session application identity to the payer address and recipient.
# Keep this server-only; changing it intentionally invalidates stored identity bindings.
REACH_MPP_IDENTITY_SECRET=
# Optional payee-side signer for scheduled MPP session settlement/close. It must equal
# REACH_MPP_RECIPIENT_ADDRESS and must never be exposed to browser/Vite variables.
REACH_MPP_SETTLEMENT_PRIVATE_KEY=

# Phase 2 recipient claim app. The fee payer key is server-only.
REACH_RPC_URL=https://rpc.moderato.tempo.xyz
REACH_VAULT_ADDRESS=0x98262c02746f3b91342249159deeebe87a54266c
REACH_FEE_PAYER_PRIVATE_KEY=

# Protected Claims (server-only; never expose these through Vite/client env)
# 32 random bytes encoded as lowercase/uppercase hex.
REACH_PROTECTED_CLAIMS_ENCRYPTION_KEY=
# Twilio Verify v2 credentials (SMS only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Reach-generated email OTP delivery through Gmail API OAuth2 (server-only).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
REACH_PROTECTED_EMAIL_FROM=
REACH_ORIGIN=http://127.0.0.1:5173
REACH_RP_ID=127.0.0.1
VITE_TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
VITE_REACH_VAULT_ADDRESS=0x98262c02746f3b91342249159deeebe87a54266c
