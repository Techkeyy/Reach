{
  "name": "reach",
  "version": "0.2.0",
  "private": true,
  "description": "Walletless stablecoin payout infrastructure on Tempo.",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24.14.0" },
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "build:contract": "hardhat build",
    "test": "hardhat test test/ReachPayoutVault.ts test/batchAtomicity.test.ts test/agentAccessKey.test.ts",
    "test:contract": "hardhat test test/ReachPayoutVault.ts",
    "test:phase2": "tsx --test test/claimLink.test.ts test/payoutDiscovery.test.ts",
    "test:phase4": "hardhat test test/batchAtomicity.test.ts test/agentAccessKey.test.ts",
    "test:unit": "tsx --test test/authFlow.test.ts test/claimLink.test.ts test/payoutDiscovery.test.ts test/serverApp.test.ts test/claimRecovery.test.ts test/testnetFunding.test.ts test/expirySelection.test.ts test/walletTransfer.test.ts test/financialQuote.test.ts",
    "test:all": "hardhat test test/ReachPayoutVault.ts test/batchAtomicity.test.ts test/agentAccessKey.test.ts && tsx --test test/claimLink.test.ts test/payoutDiscovery.test.ts test/serverApp.test.ts test/claimRecovery.test.ts test/expirySelection.test.ts test/walletTransfer.test.ts test/financialQuote.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "build:api": "esbuild src/server/serverlessHandler.ts --bundle --platform=node --format=esm --outfile=api/index.js --packages=external",
    "build:web": "vite build && esbuild src/server/serverlessHandler.ts --bundle --platform=node --format=esm --outfile=api/index.js --packages=external",
    "dev:web": "vite --host localhost",
    "dev:server": "tsx src/server-entry.ts",
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:web\"",
    "deploy:moderato": "hardhat run scripts/deploy-moderato.ts --network tempoModerato",
    "integration:moderato": "hardhat run scripts/integration-moderato.ts --network tempoModerato",
    "create:claim-link": "tsx scripts/create-claim-link.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1", "@openzeppelin/contracts": "5.6.1", "@tanstack/react-query": "5.103.2", "@types/node": "26.6.2", "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "accounts": "0.18.4", "dotenv": "18.0.1", "hono": "4.13.8", "react": "19.3.0", "react-dom": "19.3.0", "viem": "2.56.8", "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7", "@playwright/test": "1.63.0", "@vitejs/plugin-react": "6.1.1", "concurrently": "10.0.5", "esbuild": "0.28.2", "hardhat": "3.17.0", "tsx": "4.23.15", "typescript": "7.0.2", "vite": "8.3.0"
  }
}
