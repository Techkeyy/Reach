{
  "name": "reach",
  "version": "0.1.0",
  "private": true,
  "description": "Walletless stablecoin payout infrastructure on Tempo.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "build:contract": "hardhat build",
    "test": "hardhat test",
    "test:contract": "hardhat test",
    "typecheck": "tsc --noEmit",
    "deploy:moderato": "hardhat run scripts/deploy-moderato.ts --network tempoModerato",
    "integration:moderato": "hardhat run scripts/integration-moderato.ts --network tempoModerato"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "hardhat": "3.17.0",
    "typescript": "7.0.2"
  }
}
